{
  "name": "qbem",
  "version": "4.0.2",
  "description": "A Quick BEM helper!",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Scott Linenberger",
    "url": "https://github.com/scott-linenberger"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scott-linenberger/qbem.git"
  },
  "keywords": [
    "bem",
    "css",
    "helper",
    "util",
    "style",
    "classnames"
  ],
  "license": "GPL-3.0-or-later",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --minify",
    "dev": "tsup src/index.ts --watch",
    "test": "jest",
    "coverage": "jest --coverage && jest-coverage-badges",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-coverage-badges": "^1.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5"
  }
}
